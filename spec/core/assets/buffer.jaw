# Buffer asset: raw bytes that other assets reference via BufferView. Content
# may be inlined, fetched by URL, or provided via an OOB asset channel.

from "../../common.jaw" use {AssetID}
from "../../oob_asset.jaw" use {OOBAssetID}

pack BufferAssetID
- id : AssetID

# A blob of bytes that can be referred to by other assets.
seq BufferAsset
- flags : BufferAssetFlags
- source : BufferSource # inline bytes, URL, or OOB asset

bits BufferAssetFlags : u32
- 0 hint : BufferDownloadHint

enum BufferDownloadHint : u8
- IMMEDIATE = 0
- DEFER     = 1

variant BufferSource : u8
- 0 => InlineContent
- 1 => BufferFromURL
- 2 => OOBAssetID

# Inline content is limited to 4 GB to avoid stalling the main communication channel. It is HIGHLY discouraged
# to send an asset this size over the main channel! Downstream are free to disconnect rather than consume the asset!
# Large assets SHOULD be sent over the Out-Of-Band system instead, and prefer to inline only small assets.
# The definition of small assets is variable to the application, but recommendations are < 10 MB.
# Proposals to add buffer assets MUST use inline content only. 
dyn_array InlineContent : u32 * u8

# Content should be fetched from a URL. This is not allowed for use in client
# asset proposals. The byte size must be given for client preallocation.
# Clients MUST reject the asset if the fetched size differs. Clients MAY reject
# URL schemes, origins, redirects, credentials, or other fetch behavior under
# local security policy. A URL denotes an immutable payload snapshot; a producer
# must use a distinct URL when the bytes change so in-flight revisions cannot be
# confused.
seq BufferFromURL
- byte_size : u64
- url : BufferURL

dyn_array BufferURL : u16 * u8

# An OOBAssetID is scoped to one main-channel session and remains valid while a
# live BufferAsset references it. It has no meaning after that session closes.
# An ID must not be reassigned to different bytes during the session. A changed
# OOB-backed buffer revision therefore uses a fresh OOBAssetID. Multiple buffer
# assets may share an ID when they intentionally refer to the same bytes.
# OOB assets are provided after a request; sizes are included for allocation.

# A reference to a slices of a BufferAsset. Multiple BufferViews may point to the same or overlapping slices.
# As long as a view is referring to a BufferAsset, that BufferAsset must be kept alive.
# A buffer view MUST only refer to a slice inside of a buffer. Any slice that escapes the bounds of the buffer is illegal.
pack BufferView
- offset : u64
- length : u64
- asset_id : BufferAssetID
