# Image asset: references an encoded image in a buffer slice plus sampler and
# semantic flags (sRGB vs linear).

from "../../common.jaw" use {AssetID}
from "buffer.jaw" use {BufferView}

pack ImageAssetID
- id : AssetID

# Encoded image format is detected from the bytes; it is not duplicated in this
# asset. Core clients MUST support PNG and JPEG. WebP, KTX2, Radiance HDR, and
# OpenEXR are optional; clients SHOULD support as many as practical. Producers
# seeking baseline interoperability SHOULD use PNG or JPEG.

seq ImageAsset
- view : BufferView # buffer slice containing the encoded image
- flags : ImageFlags # sampling and semantic info

enum ImageSemantic : u8
- SRGB = 0
- Linear = 1

enum ImageAddressMode : u8
- ClampToEdge = 0
- Repeat = 1
- MirroredRepeat = 2
- ClampToBorder = 3

enum ImageFilterMode : u8
- Nearest = 0
- Linear = 1

enum ImageSamplerBorderColor : u8
- TransparentBlack = 0
- OpaqueBlack = 1
- OpaqueWhite = 2
- reserve 3

bits ImageFlags : u32
- 0-1   address_mode_u : ImageAddressMode
- 2-3   address_mode_v : ImageAddressMode
- 4-5   address_mode_w : ImageAddressMode
- 6-7   border_color : ImageSamplerBorderColor
- 8     mag_filter : ImageFilterMode
- 9     min_filter : ImageFilterMode
- 10    mipmap_filter : ImageFilterMode
- 11    semantic : ImageSemantic
