# Parameter components describe a small, renderer-independent UI backed by ECS
# entities. Complex application interfaces should use another mechanism, such as
# a web UI. Downstreams propose state or structural changes through ordinary
# transactions; Upstream remains authoritative and validates or rejects them.
#
# A normal parameter entity has exactly one each of:
# - ParameterComponent: common label and disabled state.
# - ParamDefinitionComponent: widget structure and validation constraints.
# - ParamStateComponent: the widget's current mutable value.
#
# Definition and state tags MUST match (Label=0 through Progress=10). This split
# keeps structural metadata separate from frequently changing state and prevents
# multiple widget states from coexisting on one entity. A receiver MAY ignore an
# invalid parameter entity rather than treating the entire connection as unusable.

from "../../common.jaw" use {EntityID}
from "interaction.jaw" use {InteractionAction}

# Marks an entry point into a parameter graph. A root carrying GlobalComponent
# is suitable for scene-wide UI such as a sidebar; otherwise it is local to the
# entity/application context that exposes it. A root need not carry definition
# or state components.
seq ParameterRootComponent

# Parameter child relationships form a directed acyclic graph. Every referenced
# child must already be alive. A child may appear under multiple parents, but it
# must not occur more than once in the same list. Disabled state is inherited
# through these relationships: descendants of a disabled parameter remain
# visible but Downstream must not propose state or structural changes to them.
dyn_array ParameterChildList : u16 * EntityID

# ==============================================================
# Misc

# Icons are well-known UTF-8 names mapped to platform-appropriate imagery. An
# unknown name may be ignored or mapped to the closest available icon.
dyn_array Icon : u8 * u8

dyn_array ParamLabelString : u8 * u8
dyn_array ParamTextString : u16 * u8

variant ParamValue : u8 
- 0 => i64
- 1 => f64

# All f64 parameter values must be finite.

# An option activates its child parameter subgraph. IDs are unique within the
# containing ModesDefinition and non-negative. -1 represents no active option
# only when none_allowed is true; all other negative values are reserved.
seq ModeOption
- label : ParamLabelString
- id    : i32
- icon  : Icon
- list  : ParameterChildList

enum ModeKind : u8
- Exclusive = 0
- Tabs = 1

dyn_array ModeList : u8 * ModeOption

seq SelectOption
- id : i32
- label : ParamLabelString

# Select option IDs follow the same uniqueness and -1 rules as mode IDs.

dyn_array SelectOptionList : u8 * SelectOption

enum LabelKind : u8
- Title = 0
- Subtitle = 1
- Help = 2
- Warning = 3

enum ButtonKind : u8
- Normal = 0
- Destructive = 1

enum RangeKind : u8
- Slider = 0
- Step = 1

seq ParameterComponent
- disabled : bool
- label : ParamLabelString

# disabled parameters remain visible but are not editable by Downstream.

enum DateTimeKind : u8
- Date = 0
- Time = 1
- DateTime = 2 

enum ContainerKind : u8
- Section = 0
- Group = 1

enum SelectKind : u8 
- Dropdown = 0
- LargeMenu = 1
- SegmentedButtons = 2

variant MaybeParamValue : u8
- 0 => void
- 1 => i64
- 2 => f64

# ==============================================================
# Definitions / Structure

seq LabelDefinition
- text : ParamTextString
- kind : LabelKind
    
# Models mutually exclusive modes. Only the active option's child subgraph is
# enabled. active_id must select an option, or be -1 when none_allowed is true.
seq ModesDefinition
- none_allowed : bool
- list : ModeList
- kind : ModeKind

seq ToggleDefinition

# Activating an enabled button executes its RPC or Event interaction action
# directly; it does not submit a parameter-state proposal. ButtonState remains
# empty because activation is transient and does not mutate parameter state.
seq ButtonDefinition
- action : InteractionAction
- button_kind : ButtonKind
    
# min, max, step, and RangeState.value use the same ParamValue variant. min must
# be <= max; step, when present, is positive; state must lie within the range.
seq RangeDefinition 
- min : ParamValue
- max : ParamValue
- step : MaybeParamValue
- unit : ParamLabelString # may be empty
- kind : RangeKind

# Raw numeric input. is_int=true requires i64 values; false requires f64.
# Present bounds/step use that same type. min <= max, step is positive, and the
# state lies within enabled bounds.
seq NumberDefinition
- is_int : bool
- min : MaybeParamValue
- max : MaybeParamValue
- step : MaybeParamValue


seq DateTimeDefinition
- kind : DateTimeKind

# Option IDs are unique and non-negative. SelectState.active_id must identify an
# option or be -1 when none_allowed is true.
seq SelectDefinition
- none_allowed : bool
- options : SelectOptionList
- kind : SelectKind

seq ListDefinition
- reorderable : bool
- allow_add : bool
- allow_remove : bool

# ListState supplies the current ordered children. reorderable/allow_add/
# allow_remove describe which downstream structural proposals are permitted;
# Upstream may still reject any proposal.

seq ContainerDefinition
- kind : ContainerKind
- list : ParameterChildList

seq ProgressDefinition

# Defines the widget type and structural metadata. Its tag must equal the tag of
# ParamStateComponent on the same entity.
variant ParamDefinitionComponent : u8
- 0  => LabelDefinition
- 1  => ModesDefinition
- 2  => ToggleDefinition
- 3  => ButtonDefinition
- 4  => RangeDefinition
- 5  => NumberDefinition
- 6  => DateTimeDefinition
- 7  => SelectDefinition
- 8  => ListDefinition
- 9  => ContainerDefinition
- 10 => ProgressDefinition

# ==============================================================
# Current State

seq LabelState
    
seq ModesState
- active_id : i32

seq ToggleState
- value : bool

seq ButtonState
    
seq RangeState
- value : ParamValue

seq NumberState
- value : ParamValue

# Date and DateTime are UTC.
# Date -> YYYY-MM-DD
# Time -> HH:MM:SS or HH:MM
# DateTime -> ISO 8601 string
# Producers SHOULD emit a valid value for DateTimeDefinition.kind. Upstream MAY
# reject a malformed proposal. A receiving client MAY display the raw value,
# ignore/drop this parameter state, or otherwise continue at its discretion.
seq DateTimeState
- value : ParamLabelString

seq SelectState
- active_id : i32

seq ListState
- list : ParameterChildList

seq ContainerState

seq ProgressState
- normalized : f64

# normalized must be finite and in [0,1].

variant ParamStateComponent : u8
- 0  => LabelState
- 1  => ModesState
- 2  => ToggleState
- 3  => ButtonState
- 4  => RangeState
- 5  => NumberState
- 6  => DateTimeState
- 7  => SelectState
- 8  => ListState
- 9  => ContainerState
- 10 => ProgressState

# Definition/state tag correspondence:
# 0 Label, 1 Modes, 2 Toggle, 3 Button, 4 Range, 5 Number,
# 6 DateTime, 7 Select, 8 List, 9 Container, 10 Progress.

# ==============================================================
# Known Icons

# action.add
# action.remove
# action.refresh
# action.reset
# action.search
# action.save
# 
# nav.back
# nav.forward
# 
# media.play
# media.pause
# 
# toggle.eye_open
# toggle.eye_closed
# toggle.check
# toggle.lock
# toggle.unlock
# 
# status.info
# status.warning
# status.error
# 
# view.zoom_in
# view.zoom_out
# view.fullscreen
# view.exit_fullscreen
# 
# misc.more_vertical
# misc.settings
# misc.close
