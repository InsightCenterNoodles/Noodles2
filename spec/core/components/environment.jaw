# Environment component: binds an environment asset with intensity and rotation
# overrides for scene lighting. Intensity must be finite and non-negative, and
# rotation must be a finite unit quaternion within implementation tolerance.
#
# When paired with GlobalComponent, this is a whole-scene environment. Producers
# SHOULD NOT commit more than one global environment; if encountered, clients
# MAY select any one. Without GlobalComponent, multiple spatial environments
# may coexist, and clients may choose whether and how to blend between them.

from "../../common.jaw" use {UnitQuaternion}
from "../assets/environment.jaw" use {EnvironmentAssetID}

pack EnvironmentComponent
- environment : EnvironmentAssetID # reference to environment asset
- intensity : f32 # scalar multiplier for environment lighting
- rotation : UnitQuaternion # applied to environment sampling
