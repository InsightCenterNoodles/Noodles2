from "../../any.jaw" use {Any, AnyMap}
from "../../common.jaw" use {ConservativeBounds, EntityID}

# =========================== SEMANTICS

# Human-readable UTF-8 explanatory text. This is not an identifier and has no
# prescribed markup language. The reusable text type is also used by discovery
# hints whose definitions are not themselves entities.
dyn_array DescriptionText : u16 * u8

seq DescriptionComponent
- text : DescriptionText

# A whitespace-delimited set of stable UTF-8 semantic identifiers. Delimiters
# are ASCII whitespace bytes (09-0D and 20). Identifiers therefore cannot
# contain unescaped ASCII whitespace. URI-like identifiers are recommended.
# Ordering carries no meaning and producers MUST NOT repeat an identifier.
# Leading, trailing, and repeated delimiters are ignored; an empty value is the
# empty set. Identity is exact token bytes after ordinary malformed-UTF-8
# handling; implementations do not perform URI or Unicode normalization. This
# compact representation deliberately avoids a nested dynamic array.
dyn_array SemanticTagList : u16 * u8

seq SemanticTagComponent
- tags : SemanticTagList

# Describes values and aspects of an entity. Every AnyMap key MUST be an
# AnyString containing a stable semantic identifier; integer keys are invalid
# here. Values may use any Any variant, including an array for a multi-valued
# property. The ordinary AnyMap uniqueness rules apply.
seq SemanticPropertyComponent
- properties : AnyMap

# The entity carrying RelationshipComponent is the relationship subject and
# target is its object. definition identifies an entity carrying
# RelationshipDefinitionComponent. Name, Description, SemanticTag,
# SemanticProperty, and Relationship components on that definition entity may
# describe its meaning or link it to external vocabularies.
pack Relationship
- definition : EntityID
- target : EntityID

dyn_array RelationshipList : u16 * Relationship

seq RelationshipComponent
- relationships : RelationshipList

# Marks an entity as a relationship definition. It is a registry entry by
# identity rather than an integer stored in a separate registry list.
seq RelationshipDefinitionComponent

# Relationship definition and target IDs are weak semantic references. A
# canonical reference may be absent or tombstoned, does not have to precede the
# relationship, and does not prevent deletion. Consumers resolve it only while
# that EntityID is alive. Proposal references must still name an existing
# canonical entity or a patch-local entity created earlier in that proposal so
# they can be remapped. Relationships do not inherit through ChildOfComponent.

# =========================== PROVENANCE AND PARTICIPATION

# Marks an entity as a known participant or other actor. It does not imply that
# the participant is currently connected and does not identify a transport
# connection. A Downstream may propose zero or more participant entities, such
# as multiple tracked people represented by one immersive client, and may pair
# them with Name, Description, SemanticTag, SemanticProperty, Transform, or
# other negotiated components. Ordinary Upstream proposal policy applies.
# Upstream MUST NOT infer or implicitly create a participant merely because a
# Downstream connected, though it may explicitly author participants known from
# application state. Participant records may remain alive after their source
# disconnects so semantic references remain meaningful.
#
# A participant TransformComponent may disclose its pose using ordinary
# transform and hierarchy semantics. Downstreams SHOULD propose pose changes at
# a low rate; approximately 4 Hz or less is recommended. Upstream may coalesce,
# rate-limit, or reject excessive pose proposals under normal resource policy.
# Clients needing smoother presentation should interpolate locally.
seq ParticipantComponent

# =========================== OBSERVATIONS

# Marks an entity as an observation, measurement, inference, annotation, or
# other reported finding. Semantic tags and properties describe its kind, value,
# unit, time, uncertainty, confidence, and provenance as applicable.
seq ObservationComponent

# Optional weak subject of an observation. Like a relationship target, the
# subject does not keep an entity alive and is resolved only while alive.
pack ObservationSubjectComponent
- subject : EntityID

# Optional region described by an observation, in the observation entity's
# local coordinate space before applying its TransformComponent and ancestor
# transforms. Bounds must satisfy the common AABB rules.
seq ObservationBoundsComponent
- bounds : ConservativeBounds

# =========================== TASKS

enum TaskState : u8
- Pending = 0
- Running = 1
- Succeeded = 2
- Failed = 3
- Cancelled = 4

# Persistent task identity and current lifecycle state. Completion changes the
# state rather than removing this component. Semantic properties may describe
# progress, cost, errors, or other application-specific task metadata. Succeeded,
# Failed, and Cancelled are terminal: once any terminal state is authoritative,
# later modification to a different TaskState is invalid. Result entities and
# other task metadata may still be added or modified afterward.
pack TaskComponent
- state : TaskState

# Result content lives on a separate result entity. That entity relates itself
# to its owning task using a relationship definition carrying the well-known
# noodles.relationship.result_of semantic tag. A task may therefore have zero,
# one, or many results. Any void explicitly means the operation returned no
# value; absence of a ResultComponent means no result has been published on
# that entity. Results may appear before the task reaches Succeeded.
seq ResultComponent
- content : Any
