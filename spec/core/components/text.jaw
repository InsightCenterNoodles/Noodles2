# Text component: local-space text rendering with color and nominal height.
# Height must be finite and positive, is measured in local scene units, and is
# affected by entity scale. Newlines are supported. Clients choose the font and
# may substitute missing glyphs; exact layout is not portable without an
# extension. Color is sRGB with authored alpha. Clients MAY ignore alpha and
# render text as opaque to avoid blending.

from "../../common.jaw" use {SRGBA8}

seq TextComponent
- color : SRGBA8
- height : f32 # nominal text height in local scene units
- text : TextComponentContent


dyn_array TextComponentContent : u16 * u8 # UTF-8
