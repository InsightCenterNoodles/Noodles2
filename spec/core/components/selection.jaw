# Selection components: opt in to selection and expose outline styling when
# selected. IsSelectedComponent is owner-written replicated state; private peer
# selection need not be transmitted. Other peers express desired changes through
# SelectionProposalComponent. Multiple entities may be selected simultaneously.

from "../../common.jaw" use {SRGB8}

seq CanSelectComponent

pack IsSelectedComponent
- color : SRGB8 # outline color when selected
