from "any.jaw" use {Any}
from "common.jaw" use {EntityID, ExtensionID, NodeID, UUID}
from "content.jaw" use {ContentMessage}
from "events.jaw" use {EventMessage}

variant MainSequenceMessage : u8
- JoinRequest = 1 => JoinRequest
- PeerJoined = 2 => PeerJoined
- JoinRejected = 3 => JoinRejected
- PeerDisconnectNotice = 4 => PeerDisconnectNotice
- PeersDisconnected = 5 => PeersDisconnected
- SnapshotBegin = 6 => SnapshotBegin
- SnapshotBatch = 7 => SnapshotBatch
- SnapshotComplete = 8 => SnapshotComplete
- ContentBatch = 9 => ContentBatch
- EventMessage = 10 => EventMessage
- RPCInvoke = 11 => RPCInvoke
- RPCReply = 12 => RPCReply
- RPCCancel = 13 => RPCCancel

dyn_array PeerName : u8 * u8
dyn_array SessionExtensionList : u16 * ExtensionID
dyn_array NodeIDList : u32 * NodeID
dyn_array ContentArray : u32 * ContentMessage

# ==============================================================
# Membership and rooted-tree routing

# UUIDs are UUIDv7 values generated freshly for each attempted session join.
# Reconnection is not defined: a disconnected implementation joins later with a
# new UUID and receives a new NodeID.
seq JoinRequest
- uuid : UUID
- parent_node : NodeID
- name : PeerName
- capabilities : SessionExtensionList

# JoinRequest travels only toward the Bookkeeper (NodeID 0). Each relay records
# the child link from which uuid arrived. The Bookkeeper accepts only peers that
# support the complete fixed session extension set and assigns a never-reused
# nonzero NodeID.

seq PeerRecord
- uuid : UUID
- node : NodeID
- parent : NodeID
- name : PeerName
- connected : bool

dyn_array PeerRecordList : u32 * PeerRecord

# The Bookkeeper broadcasts this record through the entire tree. Its arrival at
# the joining UUID is also the successful JoinRequest response. Every node adds
# the new NodeID to the child-subtree route on the recorded return path. A peer
# MUST NOT publish ContentBatch, EventMessage, or RPC traffic before receiving
# its own PeerJoined and completing its snapshot.
seq PeerJoined
- peer : PeerRecord

dyn_array JoinRejectionReason : u16 * u8

# Rejection is routed back along the pending UUID path, after which the joining
# main and OOB links close.
seq JoinRejected
- uuid : UUID
- reason : JoinRejectionReason

# When a child edge closes, the surviving parent sends the affected child and
# all of its known descendants toward the Bookkeeper. The separated subtree can
# no longer reach the Bookkeeper and its session ends immediately.
seq PeerDisconnectNotice
- reporter : NodeID
- disconnected : NodeIDList

# Bookkeeper broadcasts the resulting membership change. Listed NodeIDs and
# their entity/asset ranges are never reused. Ordinary owned ECS state freezes;
# proposal entities owned by disconnected nodes become inactive and may be
# removed. Routed requests to them fail as unreachable.
seq PeersDisconnected
- disconnected : NodeIDList

# A destination route is selected without flooding: consume locally when the
# destination is self, otherwise send into the child subtree containing it, or
# send to the parent. Join traffic establishes descendant-to-child mappings;
# PeersDisconnected removes them. Sessions are implicitly trusted in version 0,
# so origin NodeIDs provide correctness and routing identity, not authentication.

# ==============================================================
# Join snapshot

# Snapshot messages are exchanged only from a joining peer's direct parent to
# that child and MUST NOT be relayed. The parent briefly pauses scene application
# at an engine boundary, captures serialized ECS state, then resumes while
# buffering later broadcasts for the child. SnapshotBatch messages reproduce
# current live entities, components, typed assets, active proposal entities, and
# the Bookkeeper session entity. Unknown/deleted IDs need not be included.
seq SnapshotBegin
- peers : PeerRecordList

seq SnapshotBatch
- content : ContentArray

# After this marker the parent flushes buffered broadcasts in their preserved
# per-origin order. Broadcast events and routed traffic destined for the child
# are buffered as well. The child may publish only after consuming that queue.
seq SnapshotComplete

# ==============================================================
# Replicated ECS changes

# A node first changes its own engine representation, then emits one or more
# non-atomic batches from change detection. Every target entity and typed asset
# MUST be owned by origin (high 32 ID bits equal origin). Operations apply in
# content order and may be observed incrementally. A receiver applies a batch
# once and forwards it over every tree edge except the arrival edge. The strict
# tree and reliable ordered links preserve each origin's order without clocks,
# counters, acknowledgements, or loop deduplication.
seq ContentBatch
- origin : NodeID
- content : ContentArray

# ==============================================================
# Routable RPC

dyn_array RPCArgumentList : u8 * Any

# Invocation identity is (source, invocation_id). A nonzero ID is unique among
# source's in-flight invocations; zero requests no replies. destination MUST be
# the owner NodeID encoded by endpoint. Intermediate peers route but never
# execute or reply. Only destination may consume the invocation.
seq RPCInvoke
- source : NodeID
- destination : NodeID
- invocation_id : u32
- endpoint : EntityID
- args : RPCArgumentList

# Best-effort cancellation follows the same route. Unknown or completed IDs are
# ignored. A nonzero accepted invocation still produces one terminal reply unless
# the caller, target, or route disconnects.
seq RPCCancel
- source : NodeID
- destination : NodeID
- invocation_id : u32

seq RPCReply
- source : NodeID
- destination : NodeID
- invocation_id : u32
- content : RPCReplyContent

variant RPCReplyContent : u8
- Complete = 0 => RPCComplete
- Error = 1 => RPCError
- StreamResult = 2 => RPCStreamResult

seq RPCComplete
- result : Any

seq RPCStreamResult
- result : Any

dyn_array ErrorString : u32 * u8

seq RPCError
- code : u16
- message : ErrorString

# Replies route to destination (the original caller). Only the invocation target
# may originate replies. Zero-ID invocations cannot stream or reply. Deleting an
# endpoint after invocation acceptance does not cancel it. RPC side effects are
# ordinary owner-authored ContentBatch messages.
