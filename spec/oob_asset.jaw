# Why have OOB assets? To avoid cluttering the main channel
# Why not use the RPC call stuff in alternate channels? This is an optional element

# Clients may only send OOBRequest control messages. Servers send OOBReply
# control messages and, after each successful reply, one raw asset payload. A
# success and its payload form an indivisible logical reply: no other
# server-to-client OOB control or payload may occur between them. Client-to-server
# traffic may continue independently.
#
# The raw payload is transport framing, not JAW. On a byte-oriented OOB channel
# it is encoded as a little-endian u64 length followed by exactly that many raw
# bytes. On a message-oriented OOB channel it occupies the complete logical
# transport message immediately following the success control message, with no
# additional NOODLES2 prefix. A zero-length asset payload is valid.
#
# The transport may fragment the raw payload, and implementations may consume it
# incrementally without buffering the whole asset. Application-level chunk
# numbering and resume are not defined. Truncation is fatal to the OOB
# connection. After the payload ends, the receiver resumes decoding OOBReply
# control messages.

pack OOBAssetID
- id : u64

# Opaque 256-bit bearer token generated by Upstream for one main-channel
# session. It must be unpredictable and expires when that session closes.
fixed_array OOBSessionToken : 32 * u8

variant OOBRequest : u8
- Request = 0 => OOBRequestContent

seq OOBRequestContent
- token : OOBSessionToken
- asset_id : OOBAssetID

pack OOBReplyHeader
- asset_id : OOBAssetID

# UTF-8 string for error reporting
dyn_array OOBString : u16 * u8

seq OOBReplySuccess
- header : OOBReplyHeader

seq OOBReplyFailure
- asset_id : OOBAssetID
- reason : OOBString

variant OOBReply : u8
- Success = 0 => OOBReplySuccess
- Failure = 1 => OOBReplyFailure
