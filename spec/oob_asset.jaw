# Routed, content-addressed out-of-band asset transfer on a bidirectional OOB
# link associated with one main-tree edge.

from "common.jaw" use {NodeID}

fixed_array SHA256Digest : 32 * u8

seq OOBLinkToken
- bytes : SHA256Digest

# Immutable payload identity. byte_size is both a resource hint and a required
# validation check. sha256 is computed over exactly byte_size payload bytes.
seq OOBContent
- byte_size : u64
- sha256 : SHA256Digest

# The child sends this as the first control record on every initial or replacement
# OOB connection. No other OOB traffic is valid until the parent accepts the
# token. The token remains valid only while its associated main link is open;
# accepting a replacement makes it the one active OOB connection for that edge.
seq OOBLinkIntroduction
- token : OOBLinkToken

# Requests route toward destination, the current owner of the BufferAsset
# containing this OOBContent. That is normally its encoded allocator and becomes
# the Bookkeeper after allocator disconnection. A relay with verified cached
# bytes MAY answer instead of forwarding. request_id is unique among the source
# node's outstanding OOB fetches.
seq OOBFetchRequest
- source : NodeID
- destination : NodeID
- request_id : u32
- content : OOBContent

# Success routes toward destination (the original requester). responder may be
# the owner or an on-path cache. One raw payload immediately follows this control
# record. Its length and digest MUST equal content.
seq OOBFetchSuccess
- responder : NodeID
- destination : NodeID
- request_id : u32
- content : OOBContent

dyn_array OOBString : u16 * u8

# Failure is normally generated by the current owner or by a node that cannot
# restore an unavailable next hop within bounded policy. It routes back to the
# requester and completes the request.
seq OOBFetchFailure
- responder : NodeID
- destination : NodeID
- request_id : u32
- content : OOBContent
- reason : OOBString

variant OOBMessage : u8
- LinkIntroduction = 0 => OOBLinkIntroduction
- FetchRequest = 1 => OOBFetchRequest
- FetchSuccess = 2 => OOBFetchSuccess
- FetchFailure = 3 => OOBFetchFailure

# Every peer participating in an OOB edge MUST route OOB controls and stream
# payloads without buffering the entire payload. Caching is OPTIONAL.
# Requests use the same NodeID subtree routes as RPC. A node consumes a message
# addressed to itself; otherwise it sends it toward a known child subtree or
# parentward for a known destination. It MUST NOT reflect traffic onto its ingress
# edge. Traffic racing a main-link membership update may be held in a bounded
# pending-route queue, then failed. During a temporary OOB interruption, affected
# fetches may likewise be boundedly queued or failed and retried after the link
# is authenticated again. Main-sequence traffic continues independently, but a
# peer SHOULD avoid publishing new OOB-backed BufferAssets while its required
# route is unavailable.
#
# A FetchSuccess and its raw payload are indivisible in one direction. On a
# byte-oriented link the payload is a little-endian u64 length followed by the
# bytes. On a message-oriented link it is the complete next logical message.
# After forwarding or consuming exactly byte_size bytes, control decoding
# resumes. Truncation, excess length, or a digest mismatch fails the request and
# MAY close that OOB link. Cache entries are keyed by SHA256Digest and byte_size.
