from "common.jaw" use {AnAsset, AssetTypeID, ComponentTypeID, EntityID, UUID, UnitQuaternion, Vec3, Vec4}

dyn_array AnyBytes : u32 * u8
dyn_array AnyString : u32 * u8 # UTF-8
dyn_array AnyArray : u32 * Any
dyn_array AnyMap : u32 * AnyKeyPair

# Map keys support text and every integer width. Key identity consists of the
# AnyKey variant plus its exact value: for example, u8(1), u64(1), and i64(1)
# are distinct keys. String keys compare by their encoded byte sequence.
#
# Producers MUST emit unique keys. Receivers MAY reject a map with duplicate
# keys, ignore duplicates, or overwrite an earlier value. Tooling may preserve
# maps as ordered lists of pairs rather than constructing a native hash map.
variant AnyKey : u8
- String = 0 => AnyString
- U8 = 1 => u8
- U16 = 2 => u16
- U32 = 3 => u32
- U64 = 4 => u64
- I8 = 5 => i8
- I16 = 6 => i16
- I32 = 7 => i32
- I64 = 8 => i64

seq AnyKeyPair
- key : AnyKey
- value : Any

variant Any : u8
- Void = 0 => void
- Bool = 1 => bool
- U8 = 2 => u8
- I64 = 3 => i64
- F64 = 4 => f64
- String = 5 => AnyString
- Array = 6 => AnyArray
- Map = 7 => AnyMap
- Bytes = 8 => AnyBytes
- Vec3 = 9 => Vec3
- Vec4 = 10 => Vec4
- UnitQuaternion = 11 => UnitQuaternion
- UUID = 12 => UUID
- ComponentTypeID = 13 => ComponentTypeID
- AssetTypeID = 14 => AssetTypeID
- AnAsset = 15 => AnAsset
- EntityID = 16 => EntityID

# RPC argument-hint type. Values exactly match the Any discriminants above.
enum AnyTypeID : u8
- Void = 0
- Bool = 1
- U8 = 2
- I64 = 3
- F64 = 4
- String = 5
- Array = 6
- Map = 7
- Bytes = 8
- Vec3 = 9
- Vec4 = 10
- UnitQuaternion = 11
- UUID = 12
- ComponentTypeID = 13
- AssetTypeID = 14
- AnAsset = 15
- EntityID = 16
