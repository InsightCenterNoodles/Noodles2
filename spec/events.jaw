from "any.jaw" use {Any}
from "common.jaw" use {EntityID, NodeID}

# Transient broadcast event type, scoped by an entity carrying Core's
# EventRegistryComponent. The registry and definition identifier must already be
# registered before an event is sent.
pack EventTypeID
- registry : EntityID
- definition_identifier : u16

dyn_array EventArgumentList : u8 * Any

seq EventMessage
- source : NodeID
- event_type : EventTypeID
- args : EventArgumentList

# Events are stateless and are not included in initial snapshots or replayed to
# late joiners. Durable facts belong in ECS state.
#
# The source dispatches locally once and broadcasts over all of its tree edges.
# Each receiver dispatches once and forwards over every edge except the arrival
# edge. The strict tree prevents loops. Events from one source retain source
# order, but events from different sources have no global ordering. Unknown
# registries or definitions may be ignored. Argument hints are informational.
# Nodes may drop/rate-limit events or disconnect for resource protection.
