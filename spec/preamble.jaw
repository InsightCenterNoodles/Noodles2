# Core preamble messages exchanged before the main sequence starts.

from "common.jaw" use {ExtensionID}
from "oob_asset.jaw" use {OOBSessionToken}

# This is the core message that is sent during the preamble phase
variant PreMessage : u8
- 0 => Probe
- 1 => ProbeReply
- 2 => Introduction
- 3 => IntroductionReply

# Covers the base protocol, common types, and the mandatory Core extension.
# This remains version 0 while the protocol is under development.
# IMPORTANT: 0 means NO PRODUCTION IMPL ALLOWED YET. Testing only.
# IMPORTANT: When we are done with initial implementation, this MUST be incremented to 1
const PROTOCOL_VERSION : u16 = 0

dyn_array PreambleName : u8 * u8
# Encoded image bytes. Receivers identify the format from the content and may
# ignore an unsupported or unrecognized image. An empty array means no icon.
dyn_array PreambleIcon : u32 * u8
# Set of supported extension IDs. Order and duplicates have no meaning. Core
# (0x0000) and every dependency of each advertised extension must be included.
dyn_array PreambleCaps : u16 * ExtensionID

seq Probe

seq ProbeReply
- name : PreambleName
- icon : PreambleIcon

bits IntroductionFlags : u16
- 0 authority_request : u8 # requester asks to be treated as upstream authority

seq Introduction
- header : IntroductionHeader

# Sent upon opening a channel to a server. By default, the server will be Upstream, and the client Downstream.
# This can be requested to be reversed with the authority_request flag. If the server agrees, the roles will be reversed, and a 
# normal IntroductionHeader will be sent by the server to the client, following normal connection rules (with a cleared authority_request flag).
# If the server does not agree, the server will close the connection.
seq IntroductionHeader
- protocol_version : u16
- flags : IntroductionFlags
- name : PreambleName
- capabilities : PreambleCaps # extensions supported by the sender

# Network endpoints inherit the host name or address that the Downstream used
# to reach the main channel. The advertised port replaces only the port and
# MUST be nonzero; the Upstream does not need to know its externally reachable
# host name or address. A Downstream without an applicable network host ignores
# network endpoints. WebSocket transport security and TCP transport wrapping
# are selected by the applicable transport binding or application
# configuration.
# This path MUST be valid UTF-8, nonempty, and begin with '/'.
dyn_array OOBWebSocketPath : u16 * u8

seq OOBWebSocketEndpoint
- port : u16
- path : OOBWebSocketPath

pack OOBTCPEndpoint
- port : u16

# This MUST be a nonempty absolute filesystem path encoded as platform path
# bytes. Zero bytes, relative paths, and Linux abstract-namespace addresses are
# not permitted. Downstreams for which the path is not meaningful ignore this
# endpoint.
dyn_array OOBUnixPath : u16 * u8

seq OOBUnixStreamEndpoint
- path : OOBUnixPath

# WebSocket is message-oriented. TCP and Unix stream sockets are byte-oriented
# and use the u64 OOB record prefix defined by the transport framing rules. TCP
# means reliable ordered TCP, and Unix means SOCK_STREAM; datagram transports
# are not supported. Main and OOB channels are distinct connections and may use
# different transport types.
variant OOBEndpoint : u8
- 0 => OOBWebSocketEndpoint
- 1 => OOBTCPEndpoint
- 2 => OOBUnixStreamEndpoint

# Endpoints are listed in Upstream preference order. Upstreams SHOULD list
# WebSocket endpoints before other supported transports. Downstreams skip
# unsupported or inapplicable endpoints and SHOULD attempt usable endpoints in
# order, with fallback allowed after connection failure.
dyn_array OOBEndpoints : u8 * OOBEndpoint

# endpoints MUST be nonempty. token is a bearer credential for this main-channel
# session and must be included in every OOBRequest. It expires when the main
# channel closes.
seq OOBAssetChannels
- endpoints : OOBEndpoints
- token : OOBSessionToken

variant OOBAssetInfo : u8
- 0 => void
- 1 => OOBAssetChannels

seq IntroductionReply
- header : IntroductionHeader
- large_assets : OOBAssetInfo
