# Per-edge handshake performed before a child joins an existing peer session.

from "common.jaw" use {ExtensionID, NodeID}
from "oob_asset.jaw" use {OOBLinkToken}

variant PreMessage : u8
- Probe = 0 => Probe
- ProbeReply = 1 => ProbeReply
- Introduction = 2 => Introduction
- IntroductionReply = 3 => IntroductionReply

# Covers the base protocol, common types, and mandatory Core extension. Version
# 0 is development-only and MUST NOT be used by production implementations.
const PROTOCOL_VERSION : u16 = 0

dyn_array PreambleName : u8 * u8
dyn_array PreambleIcon : u32 * u8
dyn_array PreambleCaps : u16 * ExtensionID

seq Probe

seq ProbeReply
- name : PreambleName
- icon : PreambleIcon

seq Introduction
- header : IntroductionHeader

# capabilities is the complete set supported by the connecting child. It MUST
# include Core and every dependency of every advertised extension.
seq IntroductionHeader
- protocol_version : u16
- name : PreambleName
- capabilities : PreambleCaps

# Network endpoints inherit the host name or address used for the main link.
# Ports replace only the main-link port and MUST be nonzero. WebSocket paths are
# nonempty UTF-8 absolute paths beginning with '/'.
dyn_array OOBWebSocketPath : u16 * u8

seq OOBWebSocketEndpoint
- port : u16
- path : OOBWebSocketPath

pack OOBTCPEndpoint
- port : u16

# A nonempty absolute filesystem path encoded as platform path bytes. Zero
# bytes, relative paths, Linux abstract addresses, and datagrams are forbidden.
dyn_array OOBUnixPath : u16 * u8

seq OOBUnixStreamEndpoint
- path : OOBUnixPath

variant OOBEndpoint : u8
- WebSocket = 0 => OOBWebSocketEndpoint
- TCP = 1 => OOBTCPEndpoint
- UnixStream = 2 => OOBUnixStreamEndpoint

# Parent preference order. A joining peer MUST implement and connect to at least
# one endpoint advertised by its parent. WebSocket SHOULD precede other
# transports.
dyn_array OOBEndpoints : u8 * OOBEndpoint

# endpoints MUST be nonempty. token authenticates the child-initiated OOB link
# associated with this main link and expires when the main link closes.
seq OOBAssetChannel
- endpoints : OOBEndpoints
- token : OOBLinkToken

# The accepting server is the connecting node's parent in the strict rooted
# tree. session_capabilities is fixed by the Bookkeeper for the session; the
# child MUST support every listed extension or close without sending JoinRequest.
# The parent advertises one bidirectional OOB link that both sides use for routed
# asset fetches and payload forwarding. The parent MUST authenticate that link
# before forwarding the child's JoinRequest. A temporary OOB interruption does
# not close the main link: while it remains open, the child reconnects with the
# same token and the newest authenticated OOB connection replaces the broken
# one. Either peer MAY close the main edge if OOB cannot be restored within local
# policy.
seq IntroductionReply
- header : IntroductionHeader
- parent_node : NodeID
- session_capabilities : PreambleCaps
- oob_assets : OOBAssetChannel
