pack Vec2
- x : f32
- y : f32

pack Vec3
- x : f32
- y : f32
- z : f32

pack Vec4
- x : f32
- y : f32
- z : f32
- w : f32

# Conservative axis-aligned bounding box. Uses require finite coordinates with
# min <= max on every axis. Equal endpoints are valid; equality on every axis
# represents a point rather than an empty bound. The containing field or
# component defines the coordinate space.
pack AABB
- min : Vec3
- max : Vec3

# Conservative bounding sphere. Center and radius must be finite and radius
# must be non-negative. A zero radius represents a point. The containing field
# or component defines the coordinate space.
pack BoundingSphere
- center : Vec3
- radius : f32

variant ConservativeBounds : u8
- 0 => AABB
- 1 => BoundingSphere

pack UnitQuaternion
- x : f32
- y : f32
- z : f32
- w : f32

pack Mat4
- c0 : Vec4
- c1 : Vec4
- c2 : Vec4
- c3 : Vec4

pack UUID 
- a : u32
- b : u32
- c : u32
- d : u32

pack SRGB8
- r : u8
- g : u8
- b : u8

pack SRGBA8
- r : u8
- g : u8
- b : u8
- a : u8

pack LinearRGB
- r : f32
- g : f32
- b : f32

pack LinearRGBA
- r : f32
- g : f32
- b : f32
- a : f32

# Entity ID; bit 63 marks patch-local placeholders in proposals and must be clear for canonical IDs.
# Zero is a valid ID. Absence/nullability must be represented structurally rather than by a sentinel ID.
# id & (1 << 63) == 0 → real entity
# id & (1 << 63) != 0 → patch-only placeholder entity
pack EntityID
- id : u64

pack ExtensionID
- id : u16

pack ComponentTypeID
- extension : ExtensionID
- identifier : u16

pack AssetTypeID
- extension : ExtensionID
- identifier : u16

# Asset IDs are context sensitive; they have no meaning without an associated AssetTypeID.
# Zero is a valid ID. Absence/nullability must be represented structurally rather than by a sentinel ID.
# Bit 63 marks patch-local placeholders in proposals and must be clear for canonical IDs.
# id & (1 << 63) == 0 → real asset.
# id & (1 << 63) != 0 → patch-only placeholder asset.
pack AssetID
- id : u64

pack AnAsset 
- asset_type : AssetTypeID
- asset_id : AssetID
