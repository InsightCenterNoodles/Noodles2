pack Vec2
- x : f32
- y : f32

pack Vec3
- x : f32
- y : f32
- z : f32

pack Vec4
- x : f32
- y : f32
- z : f32
- w : f32

# Conservative axis-aligned bounding box. Uses require finite coordinates with
# min <= max on every axis. Equal endpoints are valid; equality on every axis
# represents a point rather than an empty bound. The containing field or
# component defines the coordinate space.
pack AABB
- min : Vec3
- max : Vec3

# Conservative bounding sphere. Center and radius must be finite and radius
# must be non-negative. A zero radius represents a point. The containing field
# or component defines the coordinate space.
pack BoundingSphere
- center : Vec3
- radius : f32

variant ConservativeBounds : u8
- AABB = 0 => AABB
- BoundingSphere = 1 => BoundingSphere

pack UnitQuaternion
- x : f32
- y : f32
- z : f32
- w : f32

pack Mat4
- c0 : Vec4
- c1 : Vec4
- c2 : Vec4
- c3 : Vec4

pack UUID 
- a : u32
- b : u32
- c : u32
- d : u32

pack SRGB8
- r : u8
- g : u8
- b : u8

pack SRGBA8
- r : u8
- g : u8
- b : u8
- a : u8

pack LinearRGB
- r : f32
- g : f32
- b : f32

pack LinearRGBA
- r : f32
- g : f32
- b : f32
- a : f32

# Session-local node identifier. Node 0 is the Bookkeeper. The Bookkeeper never
# reassigns a NodeID during a session.
pack NodeID
- id : u32

# Entity IDs divide the u64 into their allocator NodeID in the high bits
# (`id >> 32`) and an allocator-local u32 in the low bits (`id & 0xffff_ffff`).
# While that node is connected it is the entity's owner. After it disconnects,
# ownership of its live identities transfers to the Bookkeeper (NodeID 0), while
# the encoded allocator and ID remain unchanged. Only the allocator may create
# identities in its range; neither it nor a later owner may reuse an ID during
# the session. Zero is the Bookkeeper's valid local ID 0. Absence/nullability
# must be represented structurally rather than by a sentinel.
pack EntityID
- id : u64

pack ExtensionID
- id : u16

pack ComponentTypeID
- extension : ExtensionID
- identifier : u16

pack AssetTypeID
- extension : ExtensionID
- identifier : u16

# Asset IDs are context sensitive; they have no meaning without an associated
# AssetTypeID. They use the same high-u32 allocator NodeID and low-u32
# allocator-local ID division as EntityID, providing each node 2^32 IDs
# independently for every asset type. Creation, transfer after disconnection,
# and non-reuse follow the EntityID rules. An (AssetTypeID, AssetID) pair MUST
# NOT be reused during the session.
pack AssetID
- id : u64

pack AnAsset 
- asset_type : AssetTypeID
- asset_id : AssetID
