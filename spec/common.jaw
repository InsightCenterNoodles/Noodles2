pack Vec2
- x : f32
- y : f32

pack Vec3
- x : f32
- y : f32
- z : f32

pack Vec4
- x : f32
- y : f32
- z : f32
- w : f32

# Conservative axis-aligned bounding box. Uses require finite coordinates with
# min <= max on every axis. Equal endpoints are valid; equality on every axis
# represents a point rather than an empty bound. The containing field or
# component defines the coordinate space.
pack AABB
- min : Vec3
- max : Vec3

# Conservative bounding sphere. Center and radius must be finite and radius
# must be non-negative. A zero radius represents a point. The containing field
# or component defines the coordinate space.
pack BoundingSphere
- center : Vec3
- radius : f32

variant ConservativeBounds : u8
- AABB = 0 => AABB
- BoundingSphere = 1 => BoundingSphere

pack UnitQuaternion
- x : f32
- y : f32
- z : f32
- w : f32

pack Mat4
- c0 : Vec4
- c1 : Vec4
- c2 : Vec4
- c3 : Vec4

pack UUID 
- a : u32
- b : u32
- c : u32
- d : u32

pack SRGB8
- r : u8
- g : u8
- b : u8

pack SRGBA8
- r : u8
- g : u8
- b : u8
- a : u8

pack LinearRGB
- r : f32
- g : f32
- b : f32

pack LinearRGBA
- r : f32
- g : f32
- b : f32
- a : f32

# Entity IDs divide the u64 into a u32 allocation namespace in the high bits
# (`id >> 32`) and a namespace-local u32 in the low bits
# (`id & 0xffff_ffff`). Namespace 0 belongs to the Upstream;
# each Downstream receives one nonzero namespace in IntroductionReply. An
# allocator chooses the low bits and MUST NOT reuse an ID during the Upstream
# session. IDs are otherwise opaque: namespace does not imply ownership,
# authorization, lifetime, or provenance. Zero is a valid Upstream ID.
# Absence/nullability must be represented structurally rather than by a sentinel.
pack EntityID
- id : u64

pack ExtensionID
- id : u16

pack ComponentTypeID
- extension : ExtensionID
- identifier : u16

pack AssetTypeID
- extension : ExtensionID
- identifier : u16

# Asset IDs are context sensitive; they have no meaning without an associated
# AssetTypeID. They use the same high-u32 allocation namespace and low-u32 local
# ID division as EntityID. A namespace therefore provides 2^32 IDs independently
# for every asset type. Namespace does not imply ownership, authorization,
# lifetime, or provenance. An allocator MUST NOT reuse an (AssetTypeID, AssetID)
# pair during the Upstream session. Zero is a valid Upstream asset ID.
pack AssetID
- id : u64

pack AnAsset 
- asset_type : AssetTypeID
- asset_id : AssetID
