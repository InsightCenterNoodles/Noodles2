from "common.jaw" use {AnAsset, ComponentTypeID, EntityID}

variant ContentMessage : u8 
- CreateEntities = 0 => ContentCreateEntities
- DeleteEntities = 1 => ContentDeleteEntities
- ModifyComponents = 2 => ContentModifyComponents
- DeleteComponents = 3 => ContentDeleteComponents
- ModifyAsset = 4 => ContentModifyAsset
- DiscardAsset = 5 => ContentDiscardAsset
- DeleteAsset = 6 => ContentDeleteAsset

# Downstreams can propose only this restricted subset of content operations.
# Asset discard and deletion remain authority-only and cannot be encoded in a
# proposal. Payload types and discriminants match ContentMessage where present.
variant ProposedContentMessage : u8
- CreateEntities = 0 => ContentCreateEntities
- DeleteEntities = 1 => ContentDeleteEntities
- ModifyComponents = 2 => ContentModifyComponents
- DeleteComponents = 3 => ContentDeleteComponents
- ModifyAsset = 4 => ContentModifyAsset

# Unsupported/unnegotiated extension content may be skipped: receivers skip an
# entire ContentModifyComponents.content or ContentModifyAsset.content buffer,
# ignore associated component/asset deletion or discard operations, and create
# no placeholder local state. Active-reference validation applies only to
# understood state.
# An unknown type identifier inside a negotiated extension is a protocol
# violation rather than skippable extension evolution.

dyn_array EntityList : u32 * EntityID

# ===================================================
# Add or remove entities

# Every created ID is unique in this list, not alive, and never previously used
# during this Upstream session. Upstream-originated creation uses namespace 0;
# proposed creation MUST use the proposing Downstream's assigned namespace.
# Accepted proposed IDs remain unchanged in the authoritative Transaction.
# Namespace constrains creation only, not later modification policy. An entity
# remains alive even when it has no components.
seq ContentCreateEntities
- list : EntityList

# Deletion removes the entity and all its components and permanently tombstones
# its ID for this session. Active references must have been removed or redirected
# by earlier Transaction operations. Creating and then deleting an entity in one
# Transaction is valid and still consumes/tombstones the ID, although the atomic
# intermediate state is not observable. A never-seen or already tombstoned ID is
# invalid; later operations on an ID deleted earlier in the Transaction are also
# invalid.
seq ContentDeleteEntities
- list : EntityList

# Packed component data. Technical limits are 4 GB, but it is NOT recommended that Upstream send anything close
# to this. Upstream SHOULD make all efforts to break larger updates into smaller transactions. Downstreams are free
# to disconnect rather than service large transactions.
dyn_array Content : u32 * u8

# ===================================================
# Modify components attached to entities. Each entity has at most one component
# for a ComponentTypeID, and modification completely replaces its prior value.
# Repeated pairs are applied in order, so the later value wins.
#
# The target entity MUST already be alive or have been explicitly created by an
# earlier operation in the same Transaction or proposal. Component modification
# never implicitly creates an entity. A deleted or tombstoned ID cannot be
# modified or recreated.
# The content is structured as a byte stream of (EntityID, Component) pairs.
# The count is a non-authoritative hint for preallocation. Readers MUST parse
# until the content buffer is fully consumed and need not verify the count.
seq ContentModifyComponents
- component : ComponentTypeID
- count : u32
- content : Content

# The target entity MUST already be alive or have been explicitly created by an
# earlier operation in the same Transaction or proposal. Deleting an absent
# component from a live entity is a no-op. Deletion never creates an entity.
seq ContentDeleteComponents
- component : ComponentTypeID
- list : EntityList

# ===================================================
# Asset lifecycle

# Adds an asset or atomically replaces the value of an existing logical asset.
# An unknown asset ID creates an asset. Upstream-originated creation uses
# namespace 0; proposed creation MUST use the proposing Downstream's assigned
# namespace. Replacing an existing asset is not restricted by its allocation
# namespace, but remains subject to Upstream policy. A tombstoned identity
# cannot be resurrected.
# (AssetTypeID, AssetID) is the stable identity, so existing references observe
# the replacement without being rewritten. Intermediate replacement state is
# not observable. Clients must invalidate decoded, cached, or GPU resources for
# the old value, but may retain them internally until outstanding work finishes.
#
# A replacement BufferAsset must leave every active BufferView in bounds when
# the containing Transaction commits. The content is parsed as the corresponding
# *Asset type for the given extension and asset type.
seq ContentModifyAsset
- an_asset : AnAsset
- content : Content

# Drops the strong reference held by the receiver's active asset table while
# retaining a weak lookup entry. Component and asset references are strong and
# continue to keep the logical asset alive. A later reference can resolve the
# discarded asset only while at least one such live reference keeps the weak
# entry upgradeable. Otherwise Upstream must send ContentModifyAsset first,
# which republishes the asset and restores the table's strong reference.
# ContentDiscardAsset is invalid for an unknown, already discarded, or deleted
# identity. Downstreams may not propose asset discard.
seq ContentDiscardAsset
- an_asset : AnAsset

# Final deletion is sent only after discard and after earlier operations have
# removed the final protocol-visible asset/component reference. It removes the
# weak lookup entry and permanently tombstones the identity for this session.
# Receivers may still retain private implementation references for in-flight
# rendering or decoding, but those are no longer addressable by the protocol.
# Downstreams may not propose asset deletion.
seq ContentDeleteAsset
- an_asset : AnAsset
