from "common.jaw" use {AnAsset, ComponentTypeID, EntityID}

variant ContentMessage : u8 
- CreateEntities = 0 => ContentCreateEntities
- DeleteEntities = 1 => ContentDeleteEntities
- ModifyComponents = 2 => ContentModifyComponents
- DeleteComponents = 3 => ContentDeleteComponents
- ModifyAsset = 4 => ContentModifyAsset
- DeleteAsset = 5 => ContentDeleteAsset

# Every content type MUST belong to the fixed session extension set. Joining
# peers support that entire set, so an unknown type is a protocol violation.

dyn_array EntityList : u32 * EntityID

# ===================================================
# Add or remove entities

# Every created ID has the live ContentBatch origin as its encoded allocator,
# is unique in this list, is not alive, and was never previously used during the
# session. Ownership transfer never grants allocation in a retired range.
# SnapshotBatch is exempt from origin checks. An entity remains alive even when
# it has no components.
seq ContentCreateEntities
- list : EntityList

# Deleting a live entity requires the ContentBatch origin to be its current
# owner. Deletion removes the entity and all its components and tombstones its
# local engine identity. References may retain the dead ID and MUST check
# liveness before use. Creating and then deleting an entity in one batch is
# valid and still consumes the ID. Deleting an unknown or already deleted ID is
# a no-op.
seq ContentDeleteEntities
- list : EntityList

# Packed component data. The technical limit is 4 GB, but peers SHOULD divide
# large update sets into smaller batches. Receivers may disconnect rather than
# consume unsafe resource loads.
dyn_array Content : u32 * u8

# ===================================================
# Modify components attached to entities. Each entity has at most one component
# for a ComponentTypeID, and modification completely replaces its prior value.
# Repeated pairs are applied in order, so the later value wins.
#
# The target entity's current owner is the ContentBatch origin and it MUST
# already be live or have been explicitly created by an earlier operation in
# that batch. Current owner is the encoded allocator while connected, otherwise
# the Bookkeeper after PeersDisconnected transfers its live identities.
# Component modification never creates an entity. Snapshot content is exempt
# from origin checks. References inside the component may name missing or dead
# entities; component-specific semantics determine how they are interpreted.
# The content is structured as a byte stream of (EntityID, Component) pairs.
# The count is a non-authoritative hint for preallocation. Readers MUST parse
# until the content buffer is fully consumed and need not verify the count.
seq ContentModifyComponents
- component : ComponentTypeID
- count : u32
- content : Content

# The target entity follows the same ownership and liveness rules as component
# modification. Deleting an absent component is a no-op.
seq ContentDeleteComponents
- component : ComponentTypeID
- list : EntityList

# An extension may document a component type as immutable. After its owner first
# publishes that component on an entity, later replacement or deletion is
# invalid; changing the value requires a new entity identity. Core's
# ProposalTargetComponent uses this rule.

# ===================================================
# Asset lifecycle

# Adds an asset or replaces the value of an existing logical asset. The typed
# asset ID's current owner MUST be the ContentBatch origin; SnapshotBatch is
# exempt. An unknown ID creates the asset only when its encoded allocator is the
# origin. The Bookkeeper cannot allocate new identities in an inherited range.
# A deleted identity cannot be resurrected.
# (AssetTypeID, AssetID) is the stable identity, so existing references observe
# the replacement without being rewritten. Intermediate replacement state is
# not observable within this operation. Peers invalidate decoded, cached, or GPU resources for
# the old value, but may retain them internally until outstanding work finishes.
#
# A replacement BufferAsset SHOULD leave active BufferViews in bounds. A peer
# encountering an invalid view may ignore the view or disconnect for safety.
# The content is parsed as the corresponding
# *Asset type for the given extension and asset type.
seq ContentModifyAsset
- an_asset : AnAsset
- content : Content

# Deletion requires the ContentBatch origin to be the asset's current owner. It
# removes the typed asset identity from replicated state and consumes the ID
# permanently. Existing references become unresolved and MUST check asset
# liveness before use. A receiver may retain private decoded/GPU/OOB cache data,
# but it is no longer protocol-addressable through this asset identity. Deleting
# an unknown or already deleted asset is a no-op.
seq ContentDeleteAsset
- an_asset : AnAsset
